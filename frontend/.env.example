# Copy to .env.local and adjust. Nothing here is a secret.

# Base URL the browser uses for REST calls. Default "/api" goes through the
# Vite dev/preview proxy below (same origin, so no CORS needed).
# Only set an absolute URL (e.g. https://api.example.com) if that server
# sends CORS headers for this origin — the current backend does not.
VITE_TAXLAW_API_BASE_URL=/api

# Client-side timeout for GET /search, in ms. Slightly above the backend's
# DB_STATEMENT_TIMEOUT_MS (5000) so the server's 503 arrives first.
VITE_TAXLAW_API_TIMEOUT_MS=10000

# Where the Vite proxy forwards /api/* (dev and preview only). Must match the
# backend's HOST/PORT (npm run start:api in the repo root).
TAXLAW_API_PROXY_TARGET=http://127.0.0.1:3000
