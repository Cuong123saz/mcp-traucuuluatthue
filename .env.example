# Copy to .env and fill in. Never commit real credentials.

# Required. PostgreSQL 15+ with the btree_gist extension available.
DATABASE_URL=postgres://user:password@localhost:5432/taxlaw

# Optional. Defaults shown.
DB_STATEMENT_TIMEOUT_MS=5000
DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX=10
HOST=127.0.0.1
PORT=3000

# Integration tests only. MUST point at a disposable database: the suite drops
# and recreates the public schema before loading artifacts/db/schema.sql.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/taxlaw_test
